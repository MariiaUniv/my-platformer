<mxfile host="app.diagrams.net"><diagram name="Карта рівня Лаб 4" id="lab4map"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="544" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Карта рівня «Замок» — механіка: стрибок" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1330" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=none;opacity=60;" vertex="1" parent="1"><mxGeometry x="54" y="136" width="392" height="308" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;БІТ 1 · ВВЕДИ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Низька стінка на рівній підлозі.&lt;br&gt;Впасти нікуди — загинути неможливо.&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="48" width="380" height="90" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=none;opacity=60;" vertex="1" parent="1"><mxGeometry x="446" y="136" width="434" height="308" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;БІТ 2 · РОЗВИНЬ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Стінка + яма без шипів: помилка = вибиратися назад.&lt;br&gt;Стінка + яма з шипами: помилка = повернення на КТ 1.&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="452" y="48" width="422" height="90" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=none;opacity=60;" vertex="1" parent="1"><mxGeometry x="880" y="136" width="490" height="308" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;БІТ 3